---
import { inline } from './inline.mjs';
interface Props { week: string | number; items: string[] }
const { week, items } = Astro.props;
const key = `km-week-${week}-portfolio`;
---
<div class="not-content" data-km-checklist={key}>
  <ul class="km-checklist">
    {items.map((item, i) => (
      <li>
        <input type="checkbox" id={`${key}-${i}`} data-i={i} />
        <label for={`${key}-${i}`} set:html={inline(item)} />
      </li>
    ))}
  </ul>
  <p class="km-checklist-foot">Ticks are saved in this browser only. Nothing is submitted: keep these in your own repository.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-km-checklist]').forEach((root) => {
    const key = root.dataset.kmChecklist!;
    let state: Record<string, boolean> = {};
    try { state = JSON.parse(localStorage.getItem(key) || '{}'); } catch {}
    root.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((box) => {
      box.checked = Boolean(state[box.dataset.i!]);
      box.addEventListener('change', () => {
        state[box.dataset.i!] = box.checked;
        try { localStorage.setItem(key, JSON.stringify(state)); } catch {}
      });
    });
  });
</script>
