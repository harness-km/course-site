---
// Slides for a week. PDFs and Google Slides get an inline preview; other files download.
interface Props { slides: { title?: string; href: string }[] }
const { slides } = Astro.props;

const kind = (href: string) => {
  const h = href.toLowerCase().split('?')[0];
  if (h.endsWith('.pdf')) return 'pdf';
  if (h.includes('docs.google.com/presentation')) return 'google';
  if (/\.(pptx?|key|odp)$/.test(h)) return 'file';
  return 'link';
};
// Google Slides: turn a share or edit link into its embed form.
const googleEmbed = (href: string) => {
  const id = href.match(/\/presentation\/d\/([^/]+)/)?.[1];
  return id ? `https://docs.google.com/presentation/d/${id}/embed?start=false&loop=false` : href;
};
const label = (s: { title?: string; href: string }, i: number) =>
  s.title ?? (slides.length > 1 ? `Slides, part ${i + 1}` : 'Slides');
---
<div class="km-slides not-content">
  {slides.map((s, i) => {
    const k = kind(s.href);
    const external = /^https?:/.test(s.href);
    return (
      <div class="km-slide">
        <div class="km-lab">
          <a class="km-btn" href={s.href} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
            {k === 'file' ? `Download ${label(s, i).toLowerCase()}` : `Open ${label(s, i).toLowerCase()}`}
          </a>
          {k === 'pdf' && !external && (
            <a class="km-btn km-btn-ghost" href={s.href} download>Download PDF</a>
          )}
          <span class="km-lab-path">{k === 'pdf' ? 'PDF' : k === 'google' ? 'Google Slides' : k === 'file' ? 'Presentation file' : 'Link'}</span>
        </div>
        {(k === 'pdf' || k === 'google') && (
          <details class="km-slide-preview">
            <summary>Preview {label(s, i).toLowerCase()} here</summary>
            <iframe
              src={k === 'google' ? googleEmbed(s.href) : `${s.href}#view=FitH`}
              title={label(s, i)}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </details>
        )}
      </div>
    );
  })}
</div>
